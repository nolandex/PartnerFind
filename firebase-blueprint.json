{
  "entities": {
    "Token": {
      "title": "Token",
      "description": "An access token to view the landing page",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        }
      },
      "required": ["createdAt", "createdBy"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public member partner profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "bio": { "type": "string" },
        "link": { "type": "string" },
        "secretKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "bio"]
    },
    "CreatorInvite": {
      "title": "CreatorInvite",
      "description": "Invite link or token for profile creator access",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["code"]
    },
    "PartnershipSubmission": {
      "title": "PartnershipSubmission",
      "description": "Member registration submission for opportunity seeker or provider",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["pencari_peluang", "pemberi_peluang"] },
        "name": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "industry": { "type": "string" },
        "skills": { "type": "string" },
        "needs": { "type": "string" },
        "capitalRange": { "type": "string" },
        "location": { "type": "string" },
        "workPreference": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["type", "name", "whatsapp", "industry"]
    },
    "MatchResult": {
      "title": "MatchResult",
      "description": "Calculated match result between opportunity seeker and provider",
      "type": "object",
      "properties": {
        "seekerId": { "type": "string" },
        "providerId": { "type": "string" },
        "seekerName": { "type": "string" },
        "providerName": { "type": "string" },
        "seekerWhatsapp": { "type": "string" },
        "providerWhatsapp": { "type": "string" },
        "industry": { "type": "string" },
        "matchScore": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seekerId", "providerId", "matchScore", "status"]
    }
  },
  "firestore": {
    "tokens/{tokenId}": {
      "schema": {
        "$ref": "#/entities/Token"
      },
      "description": "Stores generated access tokens"
    },
    "creator_invites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/CreatorInvite"
      },
      "description": "Stores authorized profile creator invite links/tokens"
    },
    "profiles/{profileId}": {
      "schema": {
        "$ref": "#/entities/Profile"
      },
      "description": "Stores public partner profiles"
    },
    "admins/{adminId}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": ["email"]
      },
      "description": "List of authorized admins"
    },
    "settings/{settingId}": {
      "schema": {
        "type": "object",
        "properties": {
          "currentCount": { "type": "number" },
          "minIncrement": { "type": "number" },
          "maxIncrement": { "type": "number" },
          "intervalMinutes": { "type": "number" },
          "lastUpdated": { "type": "number" },
          "groupCount": { "type": "number" },
          "groupMinIncrement": { "type": "number" },
          "groupMaxIncrement": { "type": "number" },
          "groupIntervalMinutes": { "type": "number" },
          "groupLastUpdated": { "type": "number" },
          "videoEnabled": { "type": "boolean" },
          "youtubeVideoId": { "type": "string" },
          "videoTitle": { "type": "string" },
          "feature1Image": { "type": "string" },
          "feature2Image": { "type": "string" },
          "feature3Image": { "type": "string" },
          "ctaBannerImage": { "type": "string" },
          "heroHeadline": { "type": "string" },
          "heroSubheadline": { "type": "string" },
          "searchPlaceholder": { "type": "string" },
          "countdownTitle": { "type": "string" },
          "featuresLabel": { "type": "string" },
          "feature1Title": { "type": "string" },
          "feature1Desc": { "type": "string" },
          "feature2Title": { "type": "string" },
          "feature2Desc": { "type": "string" },
          "feature3Title": { "type": "string" },
          "feature3Desc": { "type": "string" },
          "ctaSubheadline": { "type": "string" },
          "ctaButtonText": { "type": "string" },
          "footerCopyright": { "type": "string" }
        }
      },
      "description": "Global application configuration, website content (video, images, texts), and synchronized live hero counter"
    },
    "partnership_submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/PartnershipSubmission"
      },
      "description": "Stores submitted partnership forms from opportunity seekers and providers"
    },
    "match_results/{matchId}": {
      "schema": {
        "$ref": "#/entities/MatchResult"
      },
      "description": "Stores calculated and approved matching results between seekers and providers"
    }
  }
}
